# Application
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace_with_a_long_random_secret

# MongoDB
# The app forces the database name to bibliogest in lib/db.ts and lib/mongodb.ts.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bibliogest

# OAuth providers used by Auth.js
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cloudinary upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bibliogest
